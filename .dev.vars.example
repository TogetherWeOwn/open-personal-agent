# Local secrets for `pnpm dev`. Copy this file to `.dev.vars` and fill in each value.
# Generate a value with: node -e "console.log(crypto.getRandomValues(Buffer.alloc(32)).toString('base64'))"
# On Cloudflare these are Worker secrets, set by `pnpm deploy:cloudflare`. Never commit real values.

# Deployment key-encryption key (KEK): 32 random bytes, base64. It wraps every user's data key.
# Losing it makes stored per-user secrets unrecoverable, so back it up.
OPA_MASTER_KEY=

# Only while rotating the KEK: the previous OPA_MASTER_KEY. Prefix the new OPA_MASTER_KEY with its
# epoch number, e.g. `2:<base64>` (a bare key is epoch 1). Delete this once every data key is
# re-wrapped and the old epoch is past the 30-day D1 Time Travel window.
# OPA_MASTER_KEY_PREV=

# Secret for signing session state: 32 random bytes, base64.
OPA_SESSION_SECRET=

# One-time token that claims a fresh deployment at /setup: 32 random bytes, base64.
OPA_SETUP_TOKEN=

# Not a secret, and optional. Off Cloudflare, the header your reverse proxy sets to the client's
# address, e.g. `X-Real-IP`. It keys the per-address rate limits. Unset, `pnpm start:node` uses the
# connection's address: right with nothing in front, but behind a proxy every client then shares
# the proxy's address, and one busy client can hold the others back from signing in.
# OPA_CLIENT_IP_HEADER=
