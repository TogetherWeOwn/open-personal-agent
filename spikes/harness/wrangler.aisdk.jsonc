// M2-16 spike, ToolLoopAgent only (bundle size). No nodejs_compat flag on purpose: the harness must run without Node APIs.
{
  "name": "opa-spike-aisdk",
  "main": "src/aisdk-worker.ts",
  "compatibility_date": "2026-10-23",
  "durable_objects": { "bindings": [{ "name": "AISDK", "class_name": "AISDKSession" }] },
  "exports": { "AISDKSession": { "type": "durable-object", "storage": "sqlite" } }
}
